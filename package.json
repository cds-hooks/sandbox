{
  "name": "cds-hooks-sandbox",
  "version": "0.1.0",
  "description": "A SPA tool that simulates the CDS Hooks standard on a mock-ehr system",
  "main": "build/bundle.js",
  "scripts": {
    "dev": "webpack-dev-server --config webpack.config.dev.js",
    "build": "webpack --config webpack.config.prod.js --progress",
    "lint": "./node_modules/.bin/eslint --ext .js,.jsx ./src --fix",
    "test": "jest"
  },
  "author": "",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cds-hooks/sandbox.git"
  },
  "bugs": {
    "url": "https://github.com/cds-hooks/sandbox/issues"
  },
  "homepage": "https://github.com/cds-hooks/sandbox#readme",
  "keywords": [
    "cds",
    "hooks",
    "sandbox"
  ],
  "dependencies": {
    "@babel/cli": "^7.29.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@mui/toolpad-core": "^0.1.51",
    "@mui/x-date-pickers": "^6.20.2",
    "@uiw/react-codemirror": "4.25.12",
    "acorn": "^8.18.0",
    "axios": "^1.20.0",
    "axios-mock-adapter": "^1.17.0",
    "classnames": "^2.2.6",
    "codemirror": "^6.0.2",
    "compare-versions": "^3.5.1",
    "debounce": "^1.2.0",
    "debounce-promise": "^3.1.2",
    "fast-deep-equal": "^2.0.1",
    "html-webpack-plugin": "^5.6.8",
    "identity-obj-proxy": "^3.0.0",
    "immer": "^11.1.18",
    "jsrsasign": "^11.1.5",
    "lodash": "^4.18.1",
    "lunr": "^2.3.6",
    "moment": "^2.31.0",
    "process": "^0.11.10",
    "prop-types": "^15.8.1",
    "query-string": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^2.8.0",
    "react-markdown": "^10.1.0",
    "react-redux": "^5.0.6",
    "react-select": "^3.2.0",
    "redux": "^3.7.2",
    "redux-immutable-state-invariant": "^2.1.0",
    "redux-logger": "^3.0.6",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.5.5",
    "@babel/plugin-transform-async-to-generator": "^7.5.0",
    "@babel/plugin-transform-spread": "^7.2.2",
    "@babel/polyfill": "^7.4.4",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-react": "^7.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "autoprefixer": "^10.6.1",
    "babel-eslint": "^10.0.3",
    "babel-jest": "^30.5.2",
    "babel-loader": "^8.0.6",
    "copy-webpack-plugin": "^14.0.0",
    "core-js": "^3.50.0",
    "css-loader": "^5.0.1",
    "eslint": "^6.8.0",
    "eslint-config-airbnb": "^18.0.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^1.7.0",
    "file-loader": "^6.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^1.6.1",
    "postcss": "^8.5.28",
    "postcss-custom-properties": "^14.0.6",
    "postcss-loader": "^4.2.0",
    "raw-loader": "^4.0.1",
    "redux-mock-store": "^1.5.5",
    "sass": "^1.105.0",
    "sass-loader": "^10.5.2",
    "style-loader": "^2.0.0",
    "terser-webpack-plugin": "^5.6.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.6",
    "webpack-merge": "^5.10.0"
  },
  "jest": {
    "setupFiles": [
      "./tests/jest-setup.js"
    ],
    "setupFilesAfterEnv": [
      "./tests/jest-setup-after-env.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|svg|pem)$": "<rootDir>/src/assets/__mocks__/fileMock.js",
      "\\.(css|scss)$": "identity-obj-proxy",
      "^react-markdown$": "<rootDir>/src/__mocks__/react-markdown.js",
      "^remark-gfm$": "<rootDir>/src/__mocks__/remark-gfm.js",
      "^rehype-raw$": "<rootDir>/src/__mocks__/rehype-raw.js"
    },
    "coveragePathIgnorePatterns": [
      "/jest-setup.js",
      "/store.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(@mui|@babel|@emotion|uuid)/)"
    ],
    "testEnvironment": "./tests/jest-environment-jsdom-global.js",
    "testEnvironmentOptions": {
      "url": "https://cds-client.org"
    }
  },
  "browserslist": {
    "production": [
      "> 0.5%",
      "last 2 versions",
      "not dead",
      "not ie 11"
    ],
    "modern": [
      "last 2 chrome versions",
      "last 2 firefox versions",
      "last 2 safari versions",
      "last 2 edge versions"
    ]
  }
}
